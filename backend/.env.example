# Copy this file to .env and replace the placeholder values with your real settings.
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"
JWT_SECRET="replace_with_a_long_random_secret"
PORT=5000

# Free key from https://data.gov.in (Sign Up -> My Account -> API Keys)
# Used to pull real mandi price data from the Agmarknet dataset.
AGMARKNET_API_KEY=your_data_gov_in_api_key
# Existing deployments may keep this key name; both are supported.
# MANDI_API_KEY=your_data_gov_in_api_key

# Where the Python ML service (ml/app.py) is running
ML_SERVICE_URL="http://localhost:8000"

# SMTP settings used only to send signup verification codes
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password_without_spaces"
SMTP_FROM="your_email@gmail.com"

GOOGLE_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"

# Optional AI assistant provider. Without AI_API_KEY, the app uses local agricultural fallback replies.
AI_API_KEY="your_ai_provider_api_key"
AI_MODEL="gpt-4o-mini"
AI_API_URL="https://api.openai.com/v1/chat/completions"
